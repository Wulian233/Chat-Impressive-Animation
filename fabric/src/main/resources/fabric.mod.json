{
	"schemaVersion": 1,
	"id": "chatimpressiveanimation",
	"version": "${version}",
	"name": "Chat Impressive Animation",
	"description": "Makes the chat look better by adding animations, such as opening/closing the chat bar, sending messages, etc. It also removes the message indicator",
	"authors": [
		"Wulian233, TexTrue"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/chat-impressive-animation",
		"sources": "https://github.com/Wulian233/Chat-Impressive-Animation",
		"issues": "https://github.com/Wulian233/Chat-Impressive-Animation/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.wulian.chatimpressiveanimation.fabric.ChatImpressiveAnimationClientFabric"
		],
		"modmenu": [
			"com.wulian.chatimpressiveanimation.fabric.ModMenuImpl"
		]
	},
	"mixins": [
		"chatimpressiveanimation.mixins.json"
	],
	"depends": {
		"minecraft": ">=1.20 <1.20.5",
		"cloth-config": "*"
	}
}
